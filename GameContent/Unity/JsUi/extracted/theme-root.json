{
  "--bg": "#0d0b08",
  "--bg-raise": "#171310",
  "--environment-backdrop": "#17130f",
  "--panel": "#241d15",
  "--line": "#3a3226",
  "--line-soft": "#4a4034",
  "--map-structure": "#7a6b54",
  "--parchment": "#e8dcc0",
  "--muted": "#8e826a",
  "--gold": "#c9a227",
  "--accent-rgb": "201, 162, 39",
  "--blood": "#8a1a1a",
  "--res-hp": "#a43c35",
  "--rot": "#b5541c",
  "--frost": "#7fa8c9",
  "--grace": "#9fc3e8",
  "--ember": "#e46a44",
  "--green": "#7fd97f",
  "--bleed": "var(--ember)",
  "--tap-floor": "calc(var(--tap-target) / var(--ui-zoom, 1))",
  "--iconbtn-size": "var(--tap-floor)",
  "--tap-floor-default": "calc(var(--tap-floor-default-target) / var(--ui-zoom, 1))",
  "--r-1": "3px",
  "--r-2": "6px",
  "--r-3": "8px",
  "--r-4": "12px",
  "--r-pill": "999px",
  "--r-round": "50%",
  "--r-1-glass": "calc(var(--r-1) / var(--ui-zoom, 1))",
  "--r-2-glass": "calc(var(--r-2) / var(--ui-zoom, 1))",
  "--r-3-glass": "calc(var(--r-3) / var(--ui-zoom, 1))",
  "--r-4-glass": "calc(var(--r-4) / var(--ui-zoom, 1))",
  "--t-1": "1rem",
  "--t-2": "1.2rem",
  "--t-3": "1.5rem",
  "--t-4": "1.8rem",
  "--font-display": "'Cinzel', Georgia, 'Times New Roman', serif",
  "--font-body": "Inter, 'Segoe UI', system-ui, sans-serif"
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">../..</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;CoopPolicyChecks.cs;CoopFlaskChecks.cs" />
    <Compile Include="$(GameRoot)/Unity/Assets/AshenSpire/Runtime/Domain/Original/*.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <None Include="route-reference.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

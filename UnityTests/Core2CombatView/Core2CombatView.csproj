<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Core 2 combat screen's plain C# view models (Runtime/Presentation/Core2/Combat, every file but the UI Toolkit
       screen Core2CombatScreen*.cs) driven over real Core2Fights from a Core 2 run, and asserted against the JS strings,
       formats, beat order and pacing at the pin. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Unity/Assets/AshenSpire/Runtime/Domain/Core2/**/*.cs" />
    <Compile Include="../../Unity/Assets/AshenSpire/Runtime/Presentation/Core2/Combat/*.cs" Exclude="../../Unity/Assets/AshenSpire/Runtime/Presentation/Core2/Combat/Core2CombatScreen*.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
</Project>

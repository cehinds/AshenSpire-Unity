/* Shared dark-fantasy materials. Presenters own state; screen sheets own geometry. */
.app { --ash-background: #101311; --ash-panel: #1b201c; --ash-inset: #121713; --ash-edge: #4b5040; --ash-ink: #efe6d3; --ash-muted: #b8b19d; --ash-gold: #d6b475; background-color: var(--ash-background); color: var(--ash-ink); }
/* High contrast (Settings → Accessibility; CampaignView puts high-contrast on the root). Token swap only,
   like the HTML body.hi-contrast in styles/base.css: brighter ink and secondary text, stronger edges.
   Visual tuning beyond these tokens is not done yet. */
.app.high-contrast { --ash-ink: #fdf6e6; --ash-muted: #cdbf9e; --ash-edge: #85714f; }
/* Display options (Settings → Display, US-15.1). CampaignView puts the classes from Domain
   OriginalDisplayOptions.RootClasses on the root; UnityTests/Mods checks these colours against it.
   Accent: the --ash-gold token, like the HTML --gold (balance.ui.accents). accent-gold keeps the
   theme's own gold above, so it needs no rule. */
.app.accent-crimson { --ash-gold: #c1453a; }
.app.accent-frost { --ash-gold: #7fa8c9; }
.app.accent-verdant { --ash-gold: #8bae54; }
.app.accent-violet { --ash-gold: #a06cc8; }
/* Map header (OriginalRunPanel map-header-*; HTML body.map-compact / hide-header-relics / hide-header-seed). */
.map-header-extras { flex-direction: row; flex-shrink: 0; align-items: center; margin: 0 0 2px; }
.map-header-seed, .map-header-relics { font-size: 11px; color: var(--ash-muted); margin: 0 12px 0 0; padding: 0; white-space: nowrap; }
.map-header-seed { flex-shrink: 0; }
.map-header-relics { flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.map-header-no-relics .map-header-relics { display: none; }
.map-header-no-seed .map-header-seed { display: none; }
.map-header-compact .map-screen > .map-header-title { font-size: 14px; margin: 0 0 1px; padding-bottom: 2px; border-bottom-width: 0; }
.map-header-compact .map-screen > .map-header-stats { font-size: 11px; margin: 0; }
.map-header-compact .map-screen > .map-header-purse { font-size: 10px; margin: 0; }
.map-header-compact .map-screen > .map-header-extras { margin: 0; }
/* Control hints (OriginalRunPanel.ControlHints; HTML .hint-bar): keyboard shortcuts under map and
   combat. Like the HTML game, wide windows only (the phone layout has no keyboard); off hides it. */
.control-hints { display: none; flex-shrink: 0; margin: 4px 0 0; font-size: 11px; color: var(--ash-muted); -unity-text-align: middle-center; white-space: normal; }
.ui-wide .control-hints { display: flex; }
.ui-wide.no-control-hints .control-hints { display: none; }
.body { max-width: 1000px; padding: 24px 20px 32px; }
.body.has-fixed-actions { padding-bottom: 110px; }
.button { background-color: var(--ash-panel); border-color: var(--ash-edge); color: var(--ash-ink); border-radius: 6px; padding: 12px 16px; }
.button:hover { background-color: #293027; border-color: var(--ash-gold); }
.button:focus { border-color: #f6dba6; border-width: 2px; }
.button:active { background-color: #3b3c2b; }
.primary { background-color: var(--ash-gold); border-color: #edce94; color: #191c16; }
.primary:hover { background-color: #ebc98d; color: #191c16; }
.button:disabled { opacity: 0.55; }
.panel { background-color: var(--ash-panel); border-color: var(--ash-edge); border-radius: 8px; padding: 18px; }
.heading, .node-title, .title { -unity-font: resource("Fonts/Cinzel-Regular"); color: var(--ash-ink); }
.heading { margin-top: 24px; font-size: 24px; }
.eyebrow, .stat { color: var(--ash-gold); }
.subtitle, .caption { color: var(--ash-muted); }
.caption { font-size: 13px; }
.lead, .detail-copy { color: #d5d1bf; }
.notice { padding: 12px; border-left-width: 3px; border-left-color: #dca277; background-color: #29251e; color: #f0c49f; }
.actions { background-color: var(--ash-background); border-radius: 0; border-top-width: 1px; border-top-color: var(--ash-edge); }
.actions > .button:disabled { background-color: var(--ash-panel); color: var(--ash-muted); border-color: var(--ash-edge); }
.original-title-background { position: absolute; left: 0; right: 0; top: 0; bottom: 0; opacity: 0.65; }
.body.title-screen { max-width: 660px; padding: 28px 18px; flex-grow: 1; justify-content: center; }
.original-title { width: 100%; padding: 30px 22px; background-color: rgba(15,20,17,0.94); border-width: 1px; border-top-width: 3px; border-color: #777050; border-top-color: var(--ash-gold); border-radius: 10px; }
.original-wordmark { -unity-font: resource("Fonts/Cinzel-Regular"); -unity-font-style: bold; -unity-text-align: middle-center; color: #fff0d0; letter-spacing: 2px; white-space: nowrap; margin: 0; }
.original-subtitle { -unity-text-align: middle-center; color: var(--ash-gold); letter-spacing: 2px; font-size: 11px; margin: 12px 0 4px; }
.original-title-invitation { color: #d1cbb8; font-size: 15px; -unity-text-align: middle-center; margin: 4px 0 18px; }
.original-menu-entry { -unity-font: resource("Fonts/Cinzel-Regular"); font-size: 14px; letter-spacing: 1px; background-color: #20271f; border-color: #525540; padding: 12px 8px; margin: 4px 0; color: var(--ash-ink); }
.original-menu-entry:hover, .original-menu-entry:focus { color: #ffebbf; background-color: #303728; border-color: var(--ash-gold); }
.original-menu-entry:disabled { color: #8b927e; background-color: #191e18; border-color: #343c2e; opacity: 1; }
.original-menu-entry.title-primary { min-height: 60px; padding: 18px 8px; background-color: var(--ash-gold); color: #181d16; font-size: 18px; -unity-font-style: bold; margin: 0 0 12px; }
.original-menu-entry.title-primary:hover { background-color: #f0cc8c; }
.title-menu-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.title-menu-grid > .button { width: 48.5%; min-width: 0; }
.large-text .body.title-screen { flex-grow: 0; flex-shrink: 0; justify-content: flex-start; }
.large-text .original-title { flex-shrink: 0; }
.large-text .title-menu-grid { flex-direction: column; flex-wrap: nowrap; flex-shrink: 0; }
.large-text .title-menu-grid > .button { width: 100%; }
.original-ornament { flex-direction: row; align-items: center; margin: 18px 0; }
.original-rule { height: 1px; background-color: #5f6349; flex-grow: 1; }
.original-gem { width: 6px; height: 6px; flex-shrink: 0; margin: 0 12px; background-color: var(--ash-gold); rotate: 45deg; }
.original-tagline { color: #b6b18e; -unity-text-align: middle-center; font-size: 10px; letter-spacing: 1px; margin: 0; }
.native-run > .heading { border-bottom-width: 1px; border-bottom-color: var(--ash-edge); padding-bottom: 8px; }
.native-stage { height: 220px; border-radius: 6px; background-color: var(--ash-panel); border-width: 1px; border-color: var(--ash-edge); }
.native-stage > .fighter { height: 210px; }
.native-target { background-color: var(--ash-panel); border-radius: 5px; }
.map-viewport { background-color: var(--ash-inset); border-radius: 8px; border-color: #67684c; }
.map-tools > .button { background-color: var(--ash-panel); }
.map-overlay { background-color: var(--ash-inset); }
.settings-screen, .profile-screen { max-width: 920px; }
.settings-screen > .eyebrow, .profile-screen > .eyebrow, .slots-screen > .eyebrow { font-size: 28px; -unity-font: resource("Fonts/Cinzel-Regular"); letter-spacing: 1px; color: var(--ash-ink); margin: 10px 0; }
.settings-navigation { flex-direction: row; flex-wrap: wrap; margin: 4px 0 16px; }
.settings-navigation > .button { flex-basis: 30%; flex-grow: 1; min-width: 0; font-size: 11px; margin: 3px; padding: 8px 4px; color: var(--ash-gold); }
.ui-wide .settings-navigation > .button { flex-basis: 15%; }
.settings-section { background-color: var(--ash-panel); border-width: 1px; border-color: var(--ash-edge); border-radius: 8px; padding: 16px; margin-bottom: 16px; }
.settings-section:focus { border-color: var(--ash-gold); }
.settings-section > .heading { color: var(--ash-gold); font-size: 18px; margin: 0 0 12px; padding: 0 0 12px; border-bottom-width: 1px; border-bottom-color: var(--ash-edge); }
.settings-section > .setting { font-size: 14px; margin: 4px 0; padding: 8px 0; }
.settings-section .unity-base-field__label { width: 46%; min-width: 0; white-space: normal; color: var(--ash-ink); }
.settings-section .unity-base-field__input { min-width: 55px; }
.settings-section .unity-base-popup-field__input { background-color: var(--ash-inset); border-color: #797a59; border-width: 1px; border-radius: 5px; padding: 8px; }
.settings-section .unity-base-popup-field__text { color: var(--ash-ink); }
.settings-section .unity-base-slider__tracker { background-color: #414c3b; height: 4px; border-radius: 4px; }
.settings-section .unity-base-slider__dragger { background-color: var(--ash-gold); border-color: #f5dfb6; border-width: 1px; width: 18px; height: 18px; border-radius: 18px; }
.settings-section .unity-toggle__checkmark { width: 22px; height: 22px; background-color: var(--ash-inset); border-width: 1px; border-color: #858361; border-radius: 4px; }
.settings-section .unity-toggle__input:checked > .unity-toggle__checkmark { background-color: #716a3c; }
.settings-section > .button { font-size: 14px; margin: 4px 0; }
.profile-discoveries { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-bottom: 22px; }
.profile-discovery { width: 100%; padding: 18px; margin-bottom: 12px; background-color: var(--ash-panel); border-width: 1px; border-color: var(--ash-edge); border-radius: 8px; }
.profile-discovery.earned { border-left-width: 3px; border-left-color: var(--ash-gold); }
.profile-discovery > .eyebrow { font-size: 10px; margin-bottom: 8px; }
.profile-discovery > .node-title { font-size: 19px; }
.profile-discovery > .caption { margin: 8px 0 0; }
.ui-wide .profile-discovery { width: 48.5%; }
.profile-history { padding: 16px; margin: 8px 0; background-color: var(--ash-panel); border-left-width: 2px; border-left-color: var(--ash-gold); border-radius: 5px; }
.original-slot { border-top-width: 2px; border-top-color: #8d8259; margin-bottom: 18px; }
.original-slot > .caption { margin: 8px 0 14px; }
.slot-actions { flex-direction: row; flex-wrap: wrap; }
.slot-actions > .button { flex-basis: 45%; flex-grow: 1; min-width: 0; margin: 4px; padding: 9px; font-size: 13px; }
.foundation-field .unity-base-field__input, .seed-field .unity-base-text-field__input { background-color: var(--ash-inset); border-color: #78785c; color: var(--ash-ink); }

/* Original-save import keeps the same palette and clear primary action. */
.primary-button { background-color: var(--ash-gold); color: #181d16; border-color: var(--ash-gold); -unity-font-style: bold; }
.primary-button:hover, .primary-button:focus { background-color: #f0cc8c; border-color: #ffdf9f; }
#native-web-import-json { flex-direction: column; align-items: stretch; margin: 12px 0; }
#native-web-import-json > .unity-base-field__label { width: auto; min-width: 0; margin: 0 0 8px; color: var(--ash-gold); }
#native-web-import-json .unity-base-text-field__input { flex-grow: 1; background-color: var(--ash-inset); color: var(--ash-ink); border-width: 1px; border-color: #78785c; border-radius: 5px; padding: 10px; white-space: normal; }
#native-web-import-json:focus .unity-base-text-field__input { border-color: var(--ash-gold); }
/* Hold-to-confirm (HoldConfirmButton.cs): the bottom bar is hold progress; armed = waiting for the second tap. */
.hold-confirm { border-color: #b26a4a; }
.hold-confirm-fill { position: absolute; left: 0; bottom: 0; height: 5px; width: 0; background-color: #e08a5c; }
.hold-confirm-holding, .hold-confirm-armed { border-color: #f0a070; border-width: 2px; background-color: #3a2a22; color: #ffe2c8; }

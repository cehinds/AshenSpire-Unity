/* Shared dark-fantasy materials. Presenters own state; screen sheets own geometry.
   Look: the HTML/JS game build 0.7.1.1815 (cehinds/AshenSpire dev 0029e160), which runs with
   high contrast on by default, so the base tokens below are its body.hi-contrast values
   (styles/base.css). Art/js1815/ui holds the rasterized frame, buttons, divider and paintings;
   Fonts holds the serif display face (Liberation Serif, the JS Georgia/Times fallback) and Inter. */
.app { --ash-background: #0d0b08; --ash-panel: #241d15; --ash-inset: #171310; --ash-edge: #6a5b43; --ash-ink: #fdf6e6; --ash-muted: #a89571; --ash-gold: #c9a227; background-color: var(--ash-background); color: var(--ash-ink); -unity-font: resource("Fonts/Inter-Regular"); }
/* The rest of the JS palette: line-soft, ink-dim, the HUD band, "go" green (every primary
   action), selection green (selected tabs), danger red, ember and the map parchment. */
.app { --ash-edge-soft: #85714f; --ash-ink-dim: #b9ac91; --ash-hud: #201b15; --ash-select: #59bd75; --ash-go-fill: #255c39; --ash-go-edge: #6fb580; --ash-go-ink: #f0fff3; --ash-danger-fill: #a51f2b; --ash-danger-edge: #e65b66; --ash-danger-ink: #fff7f3; --ash-ember: #e46a44; --ash-field: #8b7d61; }
/* High contrast (Settings → Accessibility; CampaignView puts high-contrast on the root). The JS
   default already is its high-contrast set, so this goes one step further: white ink, brass edges. */
.app.high-contrast { --ash-ink: #ffffff; --ash-muted: #cdbf9e; --ash-edge: #a58a52; --ash-edge-soft: #c2a66c; }
/* Display options (Settings → Display, US-15.1). CampaignView puts the classes from Domain
   OriginalDisplayOptions.RootClasses on the root; UnityTests/Mods checks these colours against it.
   Accent: the --ash-gold token, like the HTML --gold (balance.ui.accents). accent-gold keeps the
   theme's own gold above, so it needs no rule. */
.app.accent-crimson { --ash-gold: #c1453a; }
.app.accent-frost { --ash-gold: #7fa8c9; }
.app.accent-verdant { --ash-gold: #8bae54; }
.app.accent-violet { --ash-gold: #a06cc8; }

/* ---- Type: serif display headings in gold, Inter body, tiny tracked eyebrows ---------------- */
.app .heading, .app .node-title, .app .title { -unity-font: resource("Fonts/LiberationSerif-Bold"); -unity-font-style: normal; color: var(--ash-gold); letter-spacing: 0.5px; }
.app .eyebrow { color: var(--ash-muted); }
.app .stat { color: var(--ash-gold); }
.app .subtitle { color: var(--ash-muted); }
.app .caption { color: var(--ash-ink-dim); }
.app .lead, .app .detail-copy { color: var(--ash-ink); }
.app .notice { border-left-color: var(--ash-gold); background-color: rgba(36,29,21,0.92); color: var(--ash-ink); }
/* Sizes stay at single-class specificity so contextual rules elsewhere keep their own. */
.heading { margin-top: 18px; margin-bottom: 10px; font-size: 22px; }
.node-title { font-size: 18px; }
.title { font-size: 40px; letter-spacing: 3px; }
.eyebrow { font-size: 10px; letter-spacing: 1.8px; }
.caption { font-size: 12px; }
.lead { font-size: 14px; }
.notice { padding: 10px 12px; border-left-width: 3px; border-radius: 3px; }

/* ---- Screen shell: every non-board screen is a folio over its darkened painting ----------------
   JS .modal: #0d0b08 + leather, 1px gold border, nine-sliced brass frame (panel-folio, slice 24 at
   12 px → 48 at 2x scaled 0.25). A run screen may set the body image to none inline (combat
   surface); the gold border and the veil still frame it. Selectors here stay at .body /
   .body.<state> so the combat sheet (loaded later, same specificity) keeps the last word on
   .body.combat-screen. */
.body { width: 100%; max-width: 980px; margin: 18px 0; padding: 20px 22px 26px; background-color: rgba(13,11,8,0.92); border-width: 1px; border-color: var(--ash-gold); border-radius: 3px;
    background-image: resource("Art/js1815/ui/panel-folio"); -unity-slice-left: 48; -unity-slice-right: 48; -unity-slice-top: 48; -unity-slice-bottom: 48; -unity-slice-scale: 0.25px; }
.body.has-fixed-actions { padding-bottom: 110px; }
/* Modal head: tiny muted eyebrow, then the gold serif title with a line-soft rule under it. */
.app .body > .eyebrow { font-size: 10px; letter-spacing: 1.8px; color: var(--ash-muted); margin: 0 0 2px; }
.app .body > .subtitle { -unity-font: resource("Fonts/LiberationSerif-Bold"); font-size: 20px; letter-spacing: 1px; color: var(--ash-gold); margin: 0 0 14px; padding-bottom: 10px; border-bottom-width: 1px; border-bottom-color: var(--ash-edge-soft); }
.body.title-screen, .body.map-screen, .body.combat-screen { background-image: none; border-width: 0; background-color: rgba(0,0,0,0); }
.ui-wide .body { margin: 28px 0; }

/* ---- Buttons: kit.css neutral (#241d15, 1px line-soft, 3px), green go, red danger ------------- */
/* Geometry stays at .button specificity so every contextual rule elsewhere still places buttons. */
.button { font-size: 14px; padding: 10px 16px; border-radius: 3px; }
.app .button { background-image: none; background-color: var(--ash-panel); border-width: 1px; border-color: var(--ash-edge-soft); color: var(--ash-ink); -unity-font: resource("Fonts/Inter-Regular"); -unity-font-style: normal; }
.app .button:hover { background-color: #2e251b; border-color: var(--ash-gold); color: #ffffff; }
.app .button:active { background-color: #17130f; }
.app .button:focus { border-color: var(--ash-gold); }
.app .button:disabled { background-color: rgba(36,29,21,0.7); border-color: var(--ash-edge); color: var(--ash-muted); opacity: 1; }
.app .button.primary, .app .primary-button { background-color: var(--ash-go-fill); border-color: var(--ash-go-edge); color: var(--ash-go-ink); -unity-font: resource("Fonts/Inter-SemiBold"); }
.app .button.primary:hover, .app .button.primary:focus, .app .primary-button:hover, .app .primary-button:focus { background-color: #2d6c45; border-color: #9fdcae; color: #ffffff; }
.app .button.primary:disabled { background-color: #1c2a20; border-color: #3e5a46; color: #9fb4a3; }
.app .button.danger { background-color: var(--ash-danger-fill); border-color: var(--ash-danger-edge); color: var(--ash-danger-ink); }
.app .button.selected { color: var(--ash-select); border-color: var(--ash-select); border-bottom-width: 2px; background-color: rgba(201,162,39,0.08); }
.app .actions { background-color: rgba(13,11,8,0.96); border-radius: 0; border-top-width: 1px; border-top-color: var(--ash-edge-soft); }
.app .actions > .button:disabled { background-color: var(--ash-panel); color: var(--ash-muted); border-color: var(--ash-edge); }
/* Hold-to-confirm (HoldConfirmButton.cs): the bottom bar is hold progress; armed = waiting for the second tap. */
.hold-confirm { border-color: var(--ash-danger-edge); }
.hold-confirm-fill { position: absolute; left: 0; bottom: 0; height: 4px; width: 0; background-color: var(--ash-gold); }
.hold-confirm-holding, .hold-confirm-armed { border-color: var(--ash-gold); border-width: 2px; background-color: #3a2f1c; color: #ffffff; }

/* ---- Framed rows and panels: the brass folio frame on leather (JS .as-option, .as-detailcard) ----- */
.app .panel, .app .settings-section, .app .profile-discovery, .app .profile-history, .app .interruption-panel {
    background-image: resource("Art/js1815/ui/panel-folio"); -unity-slice-left: 48; -unity-slice-right: 48; -unity-slice-top: 48; -unity-slice-bottom: 48; -unity-slice-scale: 0.25px;
    background-color: rgba(0,0,0,0); border-width: 0; border-radius: 3px; padding: 16px 18px; margin-bottom: 12px; }

/* ---- Title (01): the tower hall, a gold serif wordmark, framed menu bars, green NEW GAME ------- */
.original-title-background { position: absolute; left: 0; right: 0; top: 0; bottom: 0; opacity: 1; }
.original-title-traveler { position: absolute; left: 2%; bottom: 2%; width: 28%; height: 66%; opacity: 1; }
.app .body.title-screen { max-width: 440px; padding: 20px 14px; margin: 0; flex-grow: 1; justify-content: center; }
.app .original-title { width: 100%; padding: 0; background-image: none; background-color: rgba(0,0,0,0); border-width: 0; border-radius: 0; }
.app .original-wordmark { -unity-font: resource("Fonts/LiberationSerif-Regular"); -unity-font-style: normal; -unity-text-align: middle-center; color: var(--ash-gold); letter-spacing: 3px; white-space: nowrap; margin: 0; text-shadow: 0 2px 12px rgba(201,162,39,0.35); }
.app .original-subtitle { -unity-text-align: middle-center; color: var(--ash-ink); letter-spacing: 2.8px; font-size: 10px; margin: 10px 0 2px; }
.original-title-invitation { color: var(--ash-ink-dim); font-size: 14px; -unity-text-align: middle-center; margin: 4px 0 18px; }
.app .original-menu-entry {
    -unity-font: resource("Fonts/LiberationSerif-Regular"); -unity-font-style: normal; font-size: 15px; letter-spacing: 0.8px; color: var(--ash-ink); -unity-text-align: middle-center;
    min-height: 44px; padding: 8px; margin: 4px 0; border-width: 0; border-radius: 0; background-color: rgba(0,0,0,0);
    background-image: resource("Art/js1815/ui/button-neutral"); -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 24; -unity-slice-bottom: 24; -unity-slice-scale: 0.25px; }
.app .original-menu-entry:hover, .app .original-menu-entry:focus { color: var(--ash-gold); -unity-background-image-tint-color: #fff2d4; }
.app .original-menu-entry:active { -unity-background-image-tint-color: #c8bca6; }
.app .original-menu-entry:disabled { color: var(--ash-muted); opacity: 0.55; }
.app .original-menu-entry.title-new { background-image: resource("Art/js1815/ui/button-primary"); color: #ffffff; }
.app .original-menu-entry.title-new:hover, .app .original-menu-entry.title-new:focus { background-image: resource("Art/js1815/ui/button-primary-focus"); color: #ffffff; -unity-background-image-tint-color: #ffffff; }
/* CONTINUE (01c .slot-continue): a taller framed row in gold display caps. */
.app .original-menu-entry.title-primary { min-height: 62px; font-size: 18px; letter-spacing: 1.5px; color: var(--ash-gold); -unity-font: resource("Fonts/LiberationSerif-Bold"); margin: 0 0 8px; }
.app .original-menu-entry.title-primary:disabled { color: var(--ash-muted); }
.app .original-menu-entry.title-quick { margin-bottom: 6px; }
.app .original-menu-entry.title-more { -unity-font: resource("Fonts/Inter-Regular"); background-image: none; min-height: 36px; font-size: 11px; letter-spacing: 1.8px; color: var(--ash-ink-dim); margin-top: 0; }
.app .original-menu-entry.title-more:hover, .app .original-menu-entry.title-more:focus { color: var(--ash-gold); }
.title-menu-grid { flex-direction: column; flex-wrap: nowrap; align-items: stretch; }
.title-menu-grid > .button { width: 100%; min-width: 0; }
.large-text .body.title-screen { flex-grow: 0; flex-shrink: 0; justify-content: flex-start; }
.large-text .original-title { flex-shrink: 0; }
.large-text .title-menu-grid { flex-direction: column; flex-wrap: nowrap; flex-shrink: 0; }
.large-text .title-menu-grid > .button { width: 100%; }
/* .as-ornament: the gold hairline with the four-point star (divider-ornate.svg). */
.original-ornament { flex-direction: row; align-items: center; height: 10px; margin: 14px 40px; background-image: resource("Art/js1815/ui/divider-ornate"); -unity-background-scale-mode: scale-to-fit; }
.original-ornament > .original-rule, .original-ornament > .original-gem { display: none; }
.original-rule { height: 1px; background-color: #a58a52; flex-grow: 1; }
.original-gem { width: 6px; height: 6px; flex-shrink: 0; margin: 0 12px; background-color: var(--ash-gold); rotate: 45deg; }
.original-tagline { color: var(--ash-ink-dim); -unity-text-align: middle-center; font-size: 10px; letter-spacing: 1.5px; margin: 0; }

/* ---- Run screens (06, 08): compositions keyed by CampaignView's run-phase-* class ------------ */
.app .native-run > .map-header-title { -unity-font: resource("Fonts/Inter-Regular"); font-size: 10px; letter-spacing: 1.8px; color: var(--ash-muted); margin: 0 0 2px; padding: 0; border-bottom-width: 0; }
.app .native-run > .map-header-stats { font-size: 12px; color: var(--ash-ink); margin: 0; }
.app .native-run > .map-header-purse { font-size: 11px; color: var(--ash-gold); margin: 0 0 8px; }
.app .native-run > .node-title { font-size: 22px; margin: 6px 0 10px; padding-bottom: 10px; border-bottom-width: 1px; border-bottom-color: var(--ash-edge-soft); }
/* Option rows: each take/skip/buy/service button is a framed row with left-aligned copy. */
.app .run-phase-rewards > .button, .app .run-phase-shop > .button, .app .run-phase-shrine > .button, .app .run-phase-event > .button, .app .run-phase-draft > .button {
    -unity-text-align: middle-left; min-height: 52px; padding: 12px 18px; margin: 4px 0; font-size: 15px; color: var(--ash-ink); background-color: rgba(0,0,0,0); border-width: 0;
    background-image: resource("Art/js1815/ui/panel-folio"); -unity-slice-left: 48; -unity-slice-right: 48; -unity-slice-top: 48; -unity-slice-bottom: 48; -unity-slice-scale: 0.25px; }
.app .run-phase-rewards > .button:hover, .app .run-phase-shop > .button:hover, .app .run-phase-shrine > .button:hover, .app .run-phase-event > .button:hover, .app .run-phase-draft > .button:hover,
.app .run-phase-rewards > .button:focus, .app .run-phase-shop > .button:focus, .app .run-phase-shrine > .button:focus, .app .run-phase-event > .button:focus, .app .run-phase-draft > .button:focus { color: var(--ash-gold); -unity-background-image-tint-color: #fff2d4; }
.app .run-phase-rewards > .button:disabled, .app .run-phase-shop > .button:disabled, .app .run-phase-shrine > .button:disabled, .app .run-phase-event > .button:disabled { color: var(--ash-muted); -unity-background-image-tint-color: #8c8478; }
/* Skip rows are secondary: compact neutral buttons. */
.app .native-run > #native-skip-reward-cinders, .app .native-run > #native-skip-reward-card, .app .native-run > #native-skip-reward-flask, .app .native-run > #native-skip-reward-armament, .app .native-run > #native-skip-reward-relic {
    background-image: none; background-color: var(--ash-panel); border-width: 1px; border-color: var(--ash-edge-soft); border-radius: 3px; min-height: 40px; padding: 6px 14px; font-size: 13px; -unity-text-align: middle-center; color: var(--ash-ink-dim); }
/* The way forward is the green full-width footer action (JS Continue / Rest / Leave event). */
.app .native-run > #native-rewards-continue, .app .native-run > #native-rest, .app .native-run > #native-event-leave, .app .native-run > #native-level-confirm {
    background-image: none; background-color: var(--ash-go-fill); border-width: 1px; border-color: var(--ash-go-edge); border-radius: 3px; color: var(--ash-go-ink); -unity-text-align: middle-center; -unity-font: resource("Fonts/Inter-SemiBold"); min-height: 46px; margin-top: 12px; }
.app .native-run > #native-rewards-continue:hover, .app .native-run > #native-rest:hover, .app .native-run > #native-event-leave:hover, .app .native-run > #native-level-confirm:hover { background-color: #2d6c45; border-color: #9fdcae; color: #ffffff; }
.app .native-run > #native-rest:disabled, .app .native-run > #native-level-confirm:disabled { background-color: #1c2a20; border-color: #3e5a46; color: #9fb4a3; }
/* Leaving and returning are neutral full-width footers (JS Leave / Back). */
.app .native-run > #native-shop-leave, .app .native-run > #native-shrine-leave, .app .native-run > #native-deck, .app .native-run > #native-menu, .app .native-run > #native-deck-back, .app .native-run > #native-equipment-back, .app .native-run > #native-service-back, .app .native-run > #native-mounts-back, .app .native-run > #native-level-cancel {
    background-image: none; background-color: var(--ash-panel); border-width: 1px; border-color: var(--ash-edge-soft); border-radius: 3px; -unity-text-align: middle-center; min-height: 44px; font-size: 14px; }
/* Spoils (06): a centred folio, 564 wide. */
.app .body.run-phase-rewards { max-width: 660px; }
/* Shrine (08a) and merchant (08c): the painting at the left, the framed panel at the right. */
.ui-wide .body.run-phase-shrine { max-width: 470px; align-self: flex-end; margin-right: 24px; }
.ui-wide .body.run-phase-shop { max-width: 645px; align-self: flex-end; margin-right: 20px; }
.ui-wide .body.run-phase-shrine.map-screen, .ui-wide .body.run-phase-shop.map-screen { max-width: none; margin-right: 0; }
/* Event (08e): the stage stays painted above; the dialogue box sits under it, full width. */
.app .body.run-phase-event, .app .body.run-phase-eventresult { max-width: none; width: 100%; margin: 240px 0 0; padding: 18px 28px 24px; background-color: rgba(21,18,14,0.95); border-color: #6a5b43; }
.ui-wide .body.run-phase-event, .ui-wide .body.run-phase-eventresult { margin-top: 330px; }
.app .run-phase-event > .node-title { font-size: 16px; letter-spacing: 1.3px; padding-bottom: 6px; }
.app .run-phase-event > .lead, .app .run-phase-eventresult > .lead { font-size: 14px; color: var(--ash-ink); margin: 6px 0 12px; }
.app .run-phase-event > .button { -unity-background-image-tint-color: #e8dcc0; }

/* ---- Map (03): HUD band, act strip, khaki parchment field, dark gold-ringed medallions -------- */
.app .body.map-screen { max-width: none; width: 100%; padding: 0 0 56px; margin: 0; background-color: var(--ash-background); }
.app .map-screen > Label { margin: 0; padding: 0 16px; background-color: var(--ash-hud); }
.app .map-screen > .map-header-title { -unity-font: resource("Fonts/LiberationSerif-Bold"); font-size: 11px; letter-spacing: 1.5px; color: var(--ash-gold); padding-top: 10px; border-bottom-width: 0; }
.app .map-screen > .map-header-stats { -unity-font: resource("Fonts/Inter-SemiBold"); font-size: 14px; color: var(--ash-ink); padding-top: 3px; padding-bottom: 2px; }
.app .map-screen > .map-header-purse { font-size: 12px; color: var(--ash-ink); padding-top: 4px; padding-bottom: 2px; }
.app .map-screen > .map-header-identity { margin: 0; padding: 0 16px; background-color: var(--ash-hud); }
.app .map-screen > .map-header-extras { margin: 0; padding: 0 16px 4px; background-color: var(--ash-hud); }
.app .map-screen > .node-title { -unity-font: resource("Fonts/Inter-Regular"); font-size: 11px; letter-spacing: 1px; color: var(--ash-muted); padding: 2px 16px 6px; margin: 0; border-bottom-width: 0; }
.app .map-screen > .notice { margin: 4px 16px; }
.app .map-screen > .control-hints { margin: 0; padding: 4px 16px 0; background-color: var(--ash-background); }
.app .map-screen > .map-board { margin: 0; }
/* The JS bottom tray: hint buttons centred on a black 54 px bar (D Deck · M Menu). */
.app .map-screen > #native-deck, .app .map-screen > #native-menu { position: absolute; bottom: 3px; width: 170px; min-height: 44px; height: 50px; margin: 0; padding: 4px 10px; font-size: 13px; background-color: var(--ash-panel); border-color: #a58a52; }
.app .map-screen > #native-deck { left: 50%; translate: -176px 0; }
.app .map-screen > #native-menu { left: 50%; translate: 6px 0; }
.app .map-board { background-color: var(--ash-field); }
.app .map-act-strip { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; min-height: 40px; padding: 4px 16px; background-color: #17130f; border-bottom-width: 1px; border-bottom-color: #2a2419; }
.app .map-act-name { -unity-font: resource("Fonts/LiberationSerif-Bold"); font-size: 11px; letter-spacing: 1.5px; color: var(--ash-gold); margin: 0 16px 0 0; white-space: nowrap; }
.app .map-act-rail { flex-direction: row; align-items: center; flex-grow: 1; flex-shrink: 1; min-width: 200px; height: 30px; }
.app .map-act-end { font-size: 10px; letter-spacing: 1.2px; color: var(--ash-muted); margin: 0 6px; white-space: nowrap; }
.app .map-act-boss { color: var(--ash-ember); }
.app .map-act-track { flex-grow: 1; height: 20px; }
.app .map-viewport { background-color: var(--ash-field); border-width: 0; border-radius: 0; margin-top: 0; }
.app .map-terrain { position: absolute; left: 6%; right: 6%; top: 0; bottom: 0; opacity: 0.92; }
.app .map-node { background-image: none; background-color: var(--ash-panel); border-width: 2px; border-color: var(--ash-edge); border-radius: 200px; padding: 22%; }
.app .map-node:disabled { opacity: 0.88; }
.app .map-node.available { border-width: 3px; border-color: var(--ash-gold); background-color: var(--ash-panel); }
.app .map-node.available:hover, .app .map-node.available:focus { border-width: 4px; border-color: var(--ash-ink); background-color: #2e251b; }
.app .map-node.room-elite.available { border-color: #c4473a; }
.app .map-node.room-boss { border-color: var(--ash-ember); }
.app .map-node.visited { border-color: #b27c1f; background-color: #1a1510; }
.app .map-node.current { border-width: 4px; border-color: var(--ash-ink); background-color: var(--ash-panel); }
.app .map-node.shrine-lane { border-color: #dec46e; }
.app .map-node.revealed { border-color: #9fc3e8; }
.app .map-node-halo { position: absolute; left: -9px; top: -9px; right: -9px; bottom: -9px; border-width: 3px; border-color: rgba(201,162,39,0.42); border-radius: 300px; }
.app .map-marker { font-size: 10px; letter-spacing: 1px; color: #2a2016; -unity-font: resource("Fonts/Inter-SemiBold"); }
.app .map-dock { flex-shrink: 0; padding: 6px 12px; background-color: var(--ash-field); }
.app .map-dock .map-tools { flex-direction: row; flex-wrap: wrap; align-items: center; }
.app .map-dock .map-tool { flex-grow: 0; flex-basis: auto; min-width: 44px; min-height: 44px; margin: 3px 6px 3px 0; padding: 4px 12px; font-size: 13px; background-color: var(--ash-panel); border-color: #000000; color: var(--ash-ink); }
.app .map-dock .map-tool:hover, .app .map-dock .map-tool:focus { border-color: var(--ash-gold); }
.app .map-hint { margin: 0; padding: 4px 16px 0; font-size: 10px; letter-spacing: 1px; color: var(--ash-muted); background-color: var(--ash-background); }
.app .map-detail { margin: 0; padding: 2px 16px 4px; font-size: 12px; color: var(--ash-ink-dim); background-color: var(--ash-background); }
.app .map-overlay { background-color: rgba(13,11,8,0.96); border-width: 1px; border-color: var(--ash-gold); }
.app .map-key-text { color: var(--ash-ink); }
.map-tools > .button { background-color: var(--ash-panel); }

/* ---- Map header: the JS shared HUD band (#201b15) over the field ------------------------------- */
/* Map header (OriginalRunPanel map-header-*; HTML body.map-compact / hide-header-relics / hide-header-seed). */
.map-header-extras { flex-direction: row; flex-shrink: 0; align-items: center; margin: 0 0 2px; }
.map-header-seed, .map-header-relics { font-size: 11px; color: var(--ash-muted); margin: 0 12px 0 0; padding: 0; white-space: nowrap; }
.map-header-seed { flex-shrink: 0; }
.map-header-relics { flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.map-header-no-relics .map-header-relics { display: none; }
.map-header-no-seed .map-header-seed { display: none; }
.map-header-compact .map-screen > .map-header-title { font-size: 14px; margin: 0 0 1px; padding-bottom: 2px; border-bottom-width: 0; }
.map-header-compact .map-screen > .map-header-stats { font-size: 11px; margin: 0; }
.map-header-compact .map-screen > .map-header-purse { font-size: 10px; margin: 0; }
.map-header-compact .map-screen > .map-header-extras { margin: 0; }
/* Control hints (OriginalRunPanel.ControlHints; HTML .hint-bar): keyboard shortcuts under map and
   combat. Like the HTML game, wide windows only (the phone layout has no keyboard); off hides it. */
.control-hints { display: none; flex-shrink: 0; margin: 4px 0 0; font-size: 11px; color: var(--ash-muted); -unity-text-align: middle-center; white-space: normal; }
.ui-wide .control-hints { display: flex; }
.ui-wide.no-control-hints .control-hints { display: none; }

/* ---- Older native shells kept for compatibility --------------------------------------------- */
.native-run > .heading { border-bottom-width: 1px; border-bottom-color: var(--ash-edge-soft); padding-bottom: 8px; }
.native-stage { height: 220px; border-radius: 3px; background-color: var(--ash-panel); border-width: 1px; border-color: var(--ash-edge); }
.native-stage > .fighter { height: 210px; }
.native-target { background-color: var(--ash-panel); border-radius: 3px; }

/* ---- Settings (09): folio sections, JS tab row, pill toggles, framed selects ------------------- */
.settings-screen, .profile-screen { max-width: 920px; }
.app .settings-screen > .eyebrow, .app .profile-screen > .eyebrow, .app .slots-screen > .eyebrow { font-size: 10px; letter-spacing: 1.8px; color: var(--ash-muted); margin: 0 0 2px; }
.settings-navigation { flex-direction: row; flex-wrap: wrap; margin: 4px 0 14px; }
.app .settings-navigation > .button { flex-basis: 30%; flex-grow: 1; min-width: 0; font-size: 13px; margin: 3px; padding: 8px 4px; color: var(--ash-muted); background-color: var(--ash-panel); border-color: var(--ash-edge-soft); }
.app .settings-navigation > .button:hover, .app .settings-navigation > .button:focus { color: var(--ash-select); border-color: var(--ash-select); border-bottom-width: 2px; background-color: rgba(201,162,39,0.08); }
.ui-wide .settings-navigation > .button { flex-basis: 15%; }
.app .settings-section:focus { -unity-background-image-tint-color: #fff2d4; }
.app .settings-section > .heading { color: var(--ash-gold); font-size: 18px; margin: 0 0 10px; padding: 0 0 10px; border-bottom-width: 1px; border-bottom-color: var(--ash-edge-soft); }
.settings-section > .setting { font-size: 14px; margin: 2px 0; padding: 8px 0; border-bottom-width: 1px; border-bottom-color: rgba(133,113,79,0.35); }
.settings-section > .caption { font-size: 12px; color: #cdbf9e; }
.settings-section .unity-base-field__label { width: 46%; min-width: 0; white-space: normal; color: var(--ash-ink); font-size: 14px; }
.settings-section .unity-base-field__input { min-width: 55px; }
.settings-section .unity-base-popup-field__input { background-color: #201c15; border-color: var(--ash-edge); border-width: 1px; border-radius: 6px; padding: 8px; }
.settings-section .unity-base-popup-field__text { color: var(--ash-ink); }
.settings-section .unity-base-slider__tracker { background-color: #3a3226; height: 4px; border-radius: 4px; border-width: 0; }
.settings-section .unity-base-slider__dragger { background-color: var(--ash-gold); border-color: #f5dfb6; border-width: 1px; width: 18px; height: 18px; border-radius: 18px; }
/* JS pill toggles (51x28, panel fill, #85714f border, gold knob when on). */
.app .settings-section .unity-toggle__input { flex-grow: 1; flex-direction: row; justify-content: flex-end; }
.app .settings-section .unity-toggle__input > .unity-toggle__checkmark { width: 51px; height: 28px; background-color: rgba(0,0,0,0); border-width: 0; border-radius: 14px; -unity-background-image-tint-color: #ffffff; background-image: resource("Art/js1815/ui/toggle-off"); -unity-background-scale-mode: scale-to-fit; }
.app .settings-section .unity-toggle__input:checked > .unity-toggle__checkmark { background-color: rgba(0,0,0,0); background-image: resource("Art/js1815/ui/toggle-on"); }
.app .settings-section > .button { font-size: 14px; margin: 4px 0; }
/* Chronicle and history: framed discovery cards. */
.profile-discoveries { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-bottom: 22px; }
.profile-discovery { width: 100%; }
.app .profile-discovery.earned { -unity-background-image-tint-color: #fff0c8; }
.profile-discovery > .eyebrow { font-size: 10px; margin-bottom: 6px; }
.profile-discovery > .node-title { font-size: 18px; }
.profile-discovery > .caption { margin: 6px 0 0; }
.ui-wide .profile-discovery { width: 48.5%; }
/* Saved-climb slots (02a): folio rows; empty slots read muted. */
.original-slot > .caption { margin: 6px 0 12px; }
.slot-actions { flex-direction: row; flex-wrap: wrap; }
.app .slot-actions > .button { flex-basis: 45%; flex-grow: 1; min-width: 0; margin: 4px; padding: 9px; font-size: 13px; }
.foundation-field .unity-base-field__input, .seed-field .unity-base-text-field__input { background-color: #201c15; border-color: var(--ash-gold); color: var(--ash-ink); }
.app .interruption-cover { background-color: rgba(13,11,8,0.94); }

/* Original-save import keeps the same palette and clear primary action. */
#native-web-import-json { flex-direction: column; align-items: stretch; margin: 12px 0; }
#native-web-import-json > .unity-base-field__label { width: auto; min-width: 0; margin: 0 0 8px; color: var(--ash-gold); }
#native-web-import-json .unity-base-text-field__input { flex-grow: 1; background-color: #201c15; color: var(--ash-ink); border-width: 1px; border-color: var(--ash-edge); border-radius: 3px; padding: 10px; white-space: normal; }
#native-web-import-json:focus .unity-base-text-field__input { border-color: var(--ash-gold); }

/* Full-screen paintings and the remaining owner-supplied component skins.
   Shell surfaces (buttons, folios, title, creation, map) follow the JS build 1815 look in
   OriginalTheme.uss / OriginalCreation.uss; their earlier Art/PlayerComponents skins are no longer
   referenced here (the assets stay in the project). Paintings cover; character illustrations and
   card faces preserve their ratio. Only frame shells use nine-slicing. */
.player-component-scene, .player-component-veil { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
/* JS darkens each painting with its own wash (styles/player-polish.css world paintings). */
.player-component-veil { background-color: rgba(13,11,8,0.42); }
.player-component-veil.scene-title-hall { background-color: rgba(13,11,8,0); }
.player-component-veil.scene-merchant, .player-component-veil.scene-forge { background-color: rgba(13,11,8,0.2); }
.player-component-veil.scene-chapel-rest { background-color: rgba(13,11,8,0.3); }
.player-component-veil.scene-grave-dialogue { background-color: rgba(13,11,8,0.25); }
.app .body.combat-screen { background-color: rgba(0,0,0,0); }
.app .combat-reframed .original-combat-hud { background-image: resource("Art/PlayerComponents/hud-rail"); -unity-slice-left: 48; -unity-slice-right: 48; -unity-slice-top: 48; -unity-slice-bottom: 48; -unity-slice-scale: 0.5px; background-color: rgba(0,0,0,0); border-width: 0; }
.app .combat-energy { background-image: resource("Art/PlayerComponents/turn-orb"); -unity-background-scale-mode: scale-to-fit; background-color: rgba(0,0,0,0); border-width: 0; }
.app .original-enemy-intent { background-image: resource("Art/PlayerComponents/combat-intent"); -unity-slice-left: 36; -unity-slice-right: 36; -unity-slice-top: 36; -unity-slice-bottom: 36; -unity-slice-scale: 0.5px; background-color: rgba(0,0,0,0); border-width: 0; }
/* The face owns its fixed ratio; the parent can never stretch it to a row's height. */
.app .original-card-grid { align-items: flex-start; }
.app .original-card.card.owner-card { flex-grow: 0; flex-shrink: 0; align-self: flex-start; padding: 4px; border-top-width: 1px; }
.app .original-card-offer > .original-card { width: 180px; min-width: 180px; flex-grow: 0; }
.app .owner-card-price { background-image: resource("Art/PlayerComponents/cost-hexagon"); -unity-background-scale-mode: scale-to-fit; border-width: 0; background-color: rgba(0,0,0,0); width: 34px; height: 38px; left: -16px; top: -13px; }
/* Focused inspection keeps the fixed-ratio face centered and readable. */
.app .original-card.card.owner-card.guided-card { align-self: center; }
.app .creation-wide .original-card.card.owner-card.guided-card { width: 260px; min-width: 260px; max-width: 260px; }
.creation-card-preview .creation-step .caption { -unity-text-align: middle-center; }
.combat-reframed .original-hand-rail { height: 350px; max-height: 44%; }
/* Combat play / end-turn keep their earlier owner action plates until the combat pass restyles them. */
.app #native-end-turn { background-image: resource("Art/PlayerComponents/action-ready"); -unity-slice-left: 36; -unity-slice-right: 36; -unity-slice-top: 36; -unity-slice-bottom: 36; -unity-slice-scale: 0.5px; color: #fff0cb; background-color: rgba(0,0,0,0); border-width: 0; border-radius: 0; }
.app #native-end-turn:disabled { background-image: resource("Art/PlayerComponents/action-disabled"); color: #8f8575; opacity: 0.8; }
/* Starting items on the guided creator's equipment and relic steps. */
.app .guided-attribute { background-image: resource("Art/js1815/ui/panel-folio"); -unity-slice-left: 48; -unity-slice-right: 48; -unity-slice-top: 48; -unity-slice-bottom: 48; -unity-slice-scale: 0.25px; background-color: rgba(0,0,0,0); }
.guided-item-row { flex-direction: row; height: 76px; min-height: 44px; flex-shrink: 1; margin-bottom: 6px; }
.guided-item { flex-grow: 1; flex-shrink: 1; min-width: 0; align-items: center; }
.guided-item > Image { width: 100%; height: 54px; min-height: 28px; flex-shrink: 1; }
.guided-item > Label { color: var(--ash-ink-dim); font-size: 11px; margin: 2px 0; -unity-text-align: middle-center; }
.guided-item.guided-relic-art { flex-grow: 0; height: 130px; min-height: 70px; margin: 12px 0; }
.guided-item.guided-relic-art > Image { height: 108px; }

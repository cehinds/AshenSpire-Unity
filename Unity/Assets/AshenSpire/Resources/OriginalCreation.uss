/* OriginalCreation.uss — creator composition from the pinned original HTML.
   Warm color/type tokens come from OriginalTheme.uss. This sheet only shapes
   the creator; all sections default open and every original control ID remains.
   The parent applies a 44-CSS-pixel target floor. Do not fix heights on copy. */
.body.original-creation { max-width: 1320px; padding: 14px 18px 24px; }
.original-creation > .heading { font-size: 27px; color: #c9a227; margin: 2px 0 8px; }
.original-creation > .caption { margin: 3px 0 8px; }
.original-creation > #foundation-back { align-self: flex-start; min-width: 110px; margin: 2px 0 12px; }
.creation-section { margin: 5px 0; padding: 0; border-width: 1px; border-color: #6a5b43; border-radius: 6px; background-color: #241d15; }
.creation-section > .unity-foldout__toggle { margin: 0; padding: 9px 12px; border-bottom-width: 1px; border-bottom-color: #6a5b43; color: #c9a227; -unity-font: resource("Fonts/Cinzel-Regular"); -unity-font-style: bold; font-size: 17px; }
.creation-section > .unity-foldout__content { margin-left: 0; padding: 12px; }
.creation-workspace { flex-direction: column; align-items: stretch; }
.creation-class-preview { padding: 12px; border-width: 1px; border-color: #6a5b43; border-radius: 5px; background-color: #241d15; }
.creation-class-choices { margin-top: 12px; padding: 12px; border-width: 1px; border-color: #6a5b43; border-radius: 5px; }
.creation-wide .creation-workspace { flex-direction: row; }
.creation-wide .creation-class-preview { width: 33%; flex-shrink: 0; margin-right: 24px; }
.creation-wide .creation-class-choices { flex-grow: 1; flex-shrink: 1; margin-top: 0; min-width: 0; }
.creation-eyebrow { font-size: 10px; letter-spacing: 2px; color: #a89571; margin: 6px 0; }
.creation-class-name { -unity-font: resource("Fonts/Cinzel-Regular"); -unity-font-style: bold; font-size: 25px; color: #fdf6e6; padding-bottom: 10px; margin-bottom: 10px; border-bottom-width: 1px; border-bottom-color: #6a5b43; }
.creation-portrait-frame { width: 172px; height: 214px; align-self: center; margin: 4px 0 12px; padding: 8px; background-color: #171310; border-width: 1px; border-color: #85714f; border-radius: 5px; }
.creation-portrait { width: 100%; height: 100%; }
.creation-class-preview #native-preview-appearance { align-self: center; margin: 3px 0 8px; }
.creation-resources { flex-direction: row; flex-wrap: wrap; margin: 4px 0 8px; }
.creation-resource { color: #fdf6e6; font-size: 12px; -unity-font-style: bold; margin: 3px 12px 3px 0; white-space: nowrap; }
.creation-relic { padding: 10px; border-width: 1px; border-color: #85714f; border-radius: 5px; background-color: #171310; }
.creation-relic .node-title { color: #c9a227; font-size: 17px; margin: 0 0 4px; }
.creation-relic .caption { white-space: normal; color: #c5b99f; margin: 0; }
.creation-class-option.button { padding: 12px 16px; margin: 5px 0; min-width: 0; white-space: normal; align-items: stretch; border-radius: 6px; }
.creation-class-option.primary { border-color: #c9a227; background-color: #292217; }
.creation-option-name { -unity-font: resource("Fonts/Cinzel-Regular"); -unity-font-style: bold; color: #c9a227; font-size: 19px; margin-bottom: 5px; }
.creation-option-description { white-space: normal; color: #c5b99f; font-size: 13px; margin: 0; }
.creation-unspent { font-size: 14px; color: #c9a227; -unity-font-style: bold; margin: 6px 0; }
.creation-attributes { margin: 8px 0; }
.creation-attribute { flex-direction: row; align-items: center; padding: 8px; margin: 3px 0; border-width: 1px; border-color: #6a5b43; border-radius: 5px; min-width: 0; }
.creation-attribute-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 6px; }
.creation-attribute-name { font-size: 13px; -unity-font-style: bold; color: #fdf6e6; }
.creation-attribute-benefit { font-size: 11px; color: #b9a47c; white-space: normal; margin-top: 3px; }
.creation-attribute-controls { flex-direction: row; align-items: center; flex-shrink: 0; }
.creation-adjust.button { width: 48px; min-width: 48px; padding: 0; margin: 0; font-size: 17px; }
.creation-attribute-value { width: 28px; -unity-text-align: middle-center; font-size: 16px; color: #e8dcc0; }
.original-creation .foundation-choices > .button { width: auto; min-width: 100px; flex-grow: 1; margin: 3px; padding: 6px; }
.original-creation .foundation-field { margin: 6px 0; }
.original-creation > #native-begin { margin: 12px 0; padding: 12px; }
.creation-weapon-cards { flex-direction: row; flex-wrap: wrap; align-items: flex-start; padding-top: 8px; }
.creation-preview-card.original-card.card { width: 170px; flex-basis: 170px; flex-grow: 1; max-width: 250px; }
.creation-card-count { font-size: 10px; color: #a89571; margin: 8px 0 0; -unity-text-align: middle-center; white-space: normal; }

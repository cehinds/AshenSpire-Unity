/* OriginalCreation.uss — creator composition from the pinned original HTML.
   Warm color/type tokens come from OriginalTheme.uss. This sheet only shapes
   the creator; all sections default open and every original control ID remains.
   The parent applies a 44-CSS-pixel target floor. Do not fix heights on copy. */
.body.original-creation { max-width: 1320px; padding: 14px 18px 24px; }
.original-creation > .heading { font-size: 27px; color: var(--ash-gold); margin: 2px 0 8px; }
.original-creation > .caption { margin: 3px 0 8px; }
.original-creation > #foundation-back { align-self: flex-start; min-width: 110px; margin: 2px 0 12px; }
.creation-section { margin: 5px 0; padding: 0; border-width: 1px; border-color: var(--ash-edge); border-radius: 6px; background-color: var(--ash-panel); }
.creation-section > .unity-foldout__toggle { margin: 0; padding: 9px 12px; border-bottom-width: 1px; border-bottom-color: var(--ash-edge); color: var(--ash-gold); -unity-font: resource("Fonts/Cinzel-Regular"); -unity-font-style: bold; font-size: 17px; }
.creation-section > .unity-foldout__content { margin-left: 0; padding: 12px; }
.creation-workspace { flex-direction: column; align-items: stretch; }
.creation-class-preview { padding: 12px; border-width: 1px; border-color: var(--ash-edge); border-radius: 5px; background-color: var(--ash-panel); }
.creation-class-choices { margin-top: 12px; padding: 12px; border-width: 1px; border-color: var(--ash-edge); border-radius: 5px; }
.creation-wide .creation-workspace { flex-direction: row; }
.creation-wide .creation-class-preview { width: 33%; flex-shrink: 0; margin-right: 24px; }
.creation-wide .creation-class-choices { flex-grow: 1; flex-shrink: 1; margin-top: 0; min-width: 0; }
.creation-eyebrow { font-size: 10px; letter-spacing: 2px; color: #a89571; margin: 6px 0; }
.creation-class-name { -unity-font: resource("Fonts/Cinzel-Regular"); -unity-font-style: bold; font-size: 25px; color: #fdf6e6; padding-bottom: 10px; margin-bottom: 10px; border-bottom-width: 1px; border-bottom-color: var(--ash-edge); }
.creation-portrait-frame { width: 172px; height: 214px; align-self: center; margin: 4px 0 12px; padding: 8px; background-color: var(--ash-inset); border-width: 1px; border-color: #85714f; border-radius: 5px; }
.creation-portrait { width: 100%; height: 100%; }
.creation-class-preview #native-preview-appearance { align-self: center; margin: 3px 0 8px; }
.creation-resources { flex-direction: row; flex-wrap: wrap; margin: 4px 0 8px; }
.creation-resource { color: #fdf6e6; font-size: 12px; -unity-font-style: bold; margin: 3px 12px 3px 0; white-space: nowrap; }
.creation-relic { padding: 10px; border-width: 1px; border-color: #85714f; border-radius: 5px; background-color: var(--ash-inset); }
.creation-relic .node-title { color: var(--ash-gold); font-size: 17px; margin: 0 0 4px; }
.creation-relic .caption { white-space: normal; color: var(--ash-muted); margin: 0; }
.creation-class-option.button { padding: 12px 16px; margin: 5px 0; min-width: 0; white-space: normal; align-items: stretch; border-radius: 6px; }
.creation-class-option.primary { border-color: var(--ash-gold); background-color: #303426; }
.creation-option-name { -unity-font: resource("Fonts/Cinzel-Regular"); -unity-font-style: bold; color: var(--ash-gold); font-size: 19px; margin-bottom: 5px; }
.creation-option-description { white-space: normal; color: var(--ash-muted); font-size: 13px; margin: 0; }
.creation-unspent { font-size: 14px; color: var(--ash-gold); -unity-font-style: bold; margin: 6px 0; }
.creation-attributes { margin: 8px 0; }
.creation-attribute { flex-direction: row; align-items: center; padding: 8px; margin: 3px 0; border-width: 1px; border-color: var(--ash-edge); border-radius: 5px; min-width: 0; }
.creation-attribute-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 6px; }
.creation-attribute-name { font-size: 13px; -unity-font-style: bold; color: #fdf6e6; }
.creation-attribute-benefit { font-size: 11px; color: #b9a47c; white-space: normal; margin-top: 3px; }
.creation-attribute-controls { flex-direction: row; align-items: center; flex-shrink: 0; }
.creation-adjust.button { width: 48px; min-width: 48px; padding: 0; margin: 0; font-size: 17px; }
.creation-attribute-value { width: 28px; -unity-text-align: middle-center; font-size: 16px; color: #e8dcc0; }
.original-creation .foundation-choices > .button { width: auto; min-width: 100px; flex-grow: 1; margin: 3px; padding: 6px; }
.original-creation .foundation-field { margin: 6px 0; }
.original-creation > #native-begin { margin: 12px 0; padding: 12px; }
.creation-weapon-cards { flex-direction: row; flex-wrap: wrap; align-items: flex-start; padding-top: 8px; }
.creation-preview-card.original-card.card { width: 170px; min-width: 170px; max-width: 170px; flex-basis: 170px; flex-grow: 0; }
.creation-card-count { font-size: 10px; color: #a89571; margin: 8px 0 0; -unity-text-align: middle-center; white-space: normal; }

/* Guided creation: bounded screen, stable footer, one decision at a time. */
.body.creation-guided { max-width: 920px; padding: 16px 20px; overflow: hidden; }
.creation-guided > .heading { font-size: 26px; margin-bottom: 12px; flex-shrink: 0; }
.creation-step { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.creation-step .lead { font-size: 18px; white-space: normal; margin: 10px 0; }
.creation-step .caption { font-size: 13px; white-space: normal; }
.creation-class-grid { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.creation-class-grid > .button { width: 48%; margin: 3px 1%; min-width: 0; }
.guided-portrait { height: 180px; min-height: 100px; flex-shrink: 1; width: 100%; margin: 10px 0; }
.guided-attribute { flex-direction: row; align-items: center; min-height: 52px; margin: 4px 0; padding: 4px 8px; background-color: #211e16; }
.guided-attribute > .button { width: 48px; min-width: 48px; margin: 0; padding: 0; }
.guided-footer { flex-shrink: 0; padding-top: 12px; border-top-width: 1px; border-top-color: #a58c5d; }
.guided-navigation { flex-direction: row; flex-shrink: 0; }
.guided-navigation > .button { flex-grow: 1; flex-basis: 0; min-width: 0; }
.guided-footer > .button { margin-top: 6px; }
.creation-guided .foundation-field { flex-direction: column; margin: 8px 0; flex-shrink: 0; }
.creation-guided .unity-base-field__label { margin: 0 0 5px; min-width: 0; }
.creation-guided .unity-base-field__input { min-height: 40px; }
.guided-card.original-card.card { width: 200px; min-width: 200px; max-width: 200px; flex-grow: 0; align-self: center; margin: 20px 0 12px; }
.guided-custom { flex-grow: 1; min-height: 0; }

    --js-screen-prologue-components-sequence-presentation-speaker-color: rgb(192, 179, 157);
    --js-screen-prologue-components-sequence-presentation-text-box-color: rgb(16, 14, 12);
    --js-screen-prologue-components-sequence-presentation-text-outline-color: rgb(16, 14, 12);
    --js-screen-prologue-components-sequence-presentation-title-color: rgb(201, 162, 39);
    /* styles/base.css */
    --js-bg: rgb(13, 11, 8);
    --js-bg-raise: rgb(23, 19, 16);
    --js-bleed: rgb(228, 106, 68);
    --js-blood: rgb(138, 26, 26);
    --js-ember: rgb(228, 106, 68);
    --js-environment-backdrop: rgb(23, 19, 15);
    --js-frost: rgb(127, 168, 201);
    --js-gold: rgb(201, 162, 39);
    --js-grace: rgb(159, 195, 232);
    --js-green: rgb(127, 217, 127);
    --js-line: rgb(58, 50, 38);
    --js-line-soft: rgb(74, 64, 52);
    --js-map-structure: rgb(122, 107, 84);
    --js-muted: rgb(142, 130, 106);
    --js-panel: rgb(36, 29, 21);
    --js-parchment: rgb(232, 220, 192);
    --js-r-1: 3px;
    --js-r-2: 6px;
    --js-r-3: 8px;
    --js-r-4: 12px;
    --js-r-pill: 999px;
    --js-r-round: 50%;
    --js-res-hp: rgb(164, 60, 53);
    --js-rot: rgb(181, 84, 28);
    --js-t-1: 10px;
    --js-t-2: 12px;
    --js-t-3: 15px;
    --js-t-4: 18px;
    /* tokens.json */
    --js-motion-base: 150ms;
    --js-motion-fast: 100ms;
    --js-motion-instant: 0ms;
    --js-motion-scene: 400ms;
    --js-motion-slow: 250ms;
    --js-touch-comfortable: 48px;
    --js-touch-min-gap: 8px;
    --js-touch-primary-row: 56px;
    --js-type-body: 14px;
    --js-type-caption: 12px;
    --js-type-display: 40px;
    --js-type-lead: 16px;
    --js-type-micro: 10px;
    --js-type-minimum-body-px: 14px;
    --js-type-minimum-caption-px: 12px;
    --js-type-minimum-text-px: 11px;
    --js-type-title-l: 28px;
    --js-type-title-m: 22px;
    --js-type-title-s: 18px;
    --js-vars-compact-below-px: 768px;
    --js-vars-footer-min-px: 56px;
    --js-vars-ref-rem-px: 16px;
    --js-vars-reveal-delay-ms: 1000ms;
    --js-vars-target-px: 44px;
    /* content/hud-layout defaults */
    --js-hud-enemy-nameplate-dy: 0px;
    --js-hud-player-details-dx: 0px;
    --js-hud-player-details-dy: 0px;
    --js-hud-text-plate-bg: rgba(0, 0, 0, 0);
    --js-hud-text-plate-pad: 0px;
    --js-hud-text-plate-radius: 0px;
    --js-hud-tools-bg: rgba(0, 0, 0, 0);
    --js-hud-tools-dy: 0px;
    --js-hud-turn-ribbon-dy: 0px;
}
/* content/hud-layout/mobile.json — the app root carries form-factor-mobile (ViewportLayout.FormFactor). */
.form-factor-mobile {
    --js-hud-text-plate-bg: rgba(10, 10, 8, 0.651);
    --js-hud-text-plate-radius: 3px;
    --js-hud-text-plate-pad: 4px;
    --js-hud-player-panel-border: rgb(102, 184, 255);
    --js-hud-details-label-color: rgb(214, 175, 104);
    --js-hud-tools-bg: rgba(12, 11, 8, 0.627);
}
/* content/hud-layout/tablet.json — the app root carries form-factor-tablet (ViewportLayout.FormFactor). */
.form-factor-tablet {
    --js-hud-text-plate-bg: rgba(10, 10, 8, 0.651);
    --js-hud-text-plate-radius: 3px;
    --js-hud-text-plate-pad: 4px;
    --js-hud-player-panel-border: rgb(102, 184, 255);
    --js-hud-details-label-color: rgb(214, 175, 104);
    --js-hud-tools-bg: rgba(12, 11, 8, 0.627);
    --js-hud-header-hp-max-width: 60%;
}
/* content/hud-layout/desktop.json — the app root carries form-factor-desktop (ViewportLayout.FormFactor). */
.form-factor-desktop {
    --js-hud-text-plate-bg: rgba(10, 10, 8, 0.651);
    --js-hud-text-plate-radius: 3px;
    --js-hud-text-plate-pad: 4px;
    --js-hud-player-panel-border: rgb(102, 184, 255);
    --js-hud-details-label-color: rgb(214, 175, 104);
    --js-hud-tools-bg: rgba(12, 11, 8, 0.627);
    --js-hud-header-hp-max-width: 48%;
}
/* content/hud-layout/widescreen.json — the app root carries form-factor-widescreen (ViewportLayout.FormFactor). */
.form-factor-widescreen {
    --js-hud-text-plate-bg: rgba(10, 10, 8, 0.651);
    --js-hud-text-plate-radius: 3px;
    --js-hud-text-plate-pad: 4px;
    --js-hud-player-panel-border: rgb(102, 184, 255);
    --js-hud-details-label-color: rgb(214, 175, 104);
    --js-hud-tools-bg: rgba(12, 11, 8, 0.627);
    --js-hud-header-hp-max-width: 48%;
}

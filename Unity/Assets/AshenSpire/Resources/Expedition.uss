.app { background-color: rgb(16,19,23); color: rgb(231,224,210); }
.scroll { flex-grow: 1; }
.body { width: 100%; max-width: 650px; align-self: center; padding: 22px 18px 110px 18px; }
Label { white-space: normal; }
.eyebrow { font-size: 11px; color: rgb(202,163,100); letter-spacing: 2px; margin-bottom: 5px; }
.subtitle { font-size: 12px; color: rgb(146,149,151); margin-bottom: 15px; }
.title { font-size: 40px; -unity-font-style: bold; color: rgb(234,204,151); -unity-text-align: middle-center; letter-spacing: 4px; }
.heading { font-size: 25px; -unity-font-style: bold; color: rgb(234,204,151); margin-top: 20px; margin-bottom: 10px; }
.lead { font-size: 15px; color: rgb(188,185,177); margin-top: 10px; margin-bottom: 18px; }
.title-art { height: 245px; align-items: center; margin-bottom: 12px; }
.hero { height: 245px; width: 240px; }
.end-art { height: 260px; margin-top: 25px; }
.button { min-height: 50px; margin: 5px 0; padding: 12px; border-radius: 7px; background-color: rgb(34,39,45); color: rgb(231,224,210); border-width: 1px; border-color: rgb(73,71,63); font-size: 15px; white-space: normal; }
.button:hover { background-color: rgb(50,53,57); }
.button:active { background-color: rgb(83,65,41); }
.primary { background-color: rgb(175,124,61); color: rgb(18,19,20); -unity-font-style: bold; border-color: rgb(225,178,110); }
.primary:hover { background-color: rgb(204,151,81); }
.button:disabled { opacity: 0.4; }
.caption { font-size: 11px; color: rgb(153,154,150); margin-top: 10px; margin-bottom: 8px; }
.notice { font-size: 13px; color: rgb(238,160,126); margin: 12px 0; }
.stats { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.stat { font-size: 12px; color: rgb(221,191,145); }
.small { min-height: 44px; font-size: 12px; margin-left: 5px; }
.panel { background-color: rgb(25,30,35); border-width: 1px; border-color: rgb(60,62,60); border-radius: 10px; padding: 15px; margin-bottom: 12px; }
.node-title { font-size: 19px; -unity-font-style: bold; margin: 4px 0; }
.stage { height: 220px; flex-direction: row; justify-content: space-between; align-items: flex-end; border-radius: 10px; overflow: hidden; margin-bottom: 12px; background-color: rgb(35,34,28); }
.fighter { width: 47%; height: 200px; }
.enemy { width: 42%; margin-right: 6px; }
.intent { font-size: 13px; color: rgb(231,164,124); margin-bottom: 13px; }
.energy { font-size: 16px; color: rgb(230,194,113); -unity-font-style: bold; }
.hand { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.card { width: 31%; min-height: 132px; margin: 5px 0; padding: 8px; border-radius: 7px; background-color: rgb(33,39,45); border-width: 1px; border-color: rgb(73,78,78); color: rgb(230,224,211); align-items: flex-start; }
.card:hover { border-color: rgb(201,153,80); }
.card.selected { border-color: rgb(240,192,103); background-color: rgb(65,52,35); border-width: 2px; }
.card:disabled { opacity: 0.4; }
.cost { font-size: 19px; color: rgb(236,187,105); -unity-font-style: bold; }
.card-name { font-size: 13px; -unity-font-style: bold; margin-top: 3px; }
.card-description { font-size: 11px; margin-top: 8px; }
.card-tags { font-size: 9px; color: rgb(170,156,125); margin-top: 8px; }
.actions { position: absolute; left: 4%; right: 4%; bottom: 20px; flex-direction: row; padding: 5px; background-color: rgb(16,19,23); border-radius: 8px; }
.actions > .button { flex-grow: 1; margin-right: 5px; }
.campaign-title-art { height: 190px; width: 100%; }
.campaign-stage { height: 160px; }
.campaign-stage > .fighter { height: 150px; }
.portrait { height: 120px; width: 100%; }
.seed-field { min-height: 48px; margin: 12px 0; font-size: 15px; }
.seed-field > .unity-base-field__label { width: 48%; min-width: 0; flex-shrink: 0; white-space: normal; text-overflow: clip; color: rgb(231,224,210); }
/* Seed entry: keep the editable child readable in the runtime theme.
   Change this scoped palette for input, focus, caret and selection together. */
.seed-field .unity-base-text-field__input {
    min-width: 0;
    background-color: rgb(25,30,35);
    color: rgb(231,224,210);
    border-width: 2px;
    border-color: rgb(109,111,108);
    border-radius: 7px;
    padding-left: 10px;
    padding-right: 10px;
    --unity-cursor-color: rgb(240,192,103);
    /* Unity paints this over the glyphs, so retain transparency. */
    --unity-selection-color: rgba(175,124,61,0.35);
}
.seed-field:focus > .unity-base-field__label { color: rgb(231,224,210); }
.seed-field:focus .unity-base-text-field__input { border-color: rgb(240,192,103); }
.setting { min-height: 52px; font-size: 17px; margin: 12px 0; }
.report-field { min-height: 240px; margin: 12px 0; }
.intent-control { color: rgb(239,188,145); min-height: 48px; font-size: 13px; }
.detail-copy { font-size: 16px; color: rgb(225,220,208); margin: 12px 0; }
.inspection-row { flex-direction: row; }
.inspection-row > .button { flex-grow: 1; margin-left: 0; margin-right: 5px; }
.card.unaffordable { background-color: rgb(24,28,33); border-color: rgb(92,77,67); }
.card.unaffordable > .cost { color: rgb(227,160,140); }
.actions > .button:disabled { opacity: 1; background-color: rgb(38,42,47); color: rgb(192,190,182); border-color: rgb(78,78,73); }

.combat-feedback { position: absolute; top: 24px; left: 6px; right: 6px; padding: 7px; background-color: rgba(13,17,23,0.9); border-radius: 6px; font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.interruption-cover { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: #101317; padding: 24px 18px; }
.interruption-panel { width: 100%; max-width: 580px; align-self: center; padding: 20px 0; }
.foundation-tabs { flex-direction: row; justify-content: space-between; }
.foundation-tabs > .button { width: 32%; padding-left: 4px; padding-right: 4px; }
.foundation-choices { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.foundation-choices > .button { width: 48%; }
.foundation-field { font-size: 15px; margin: 10px 0; }
.foundation-field > .unity-base-field__label { color: rgb(231,224,210); min-width: 0; width: 32%; }
.foundation-field .unity-base-field__input { background-color: rgb(25,30,35); color: rgb(231,224,210); border-color: rgb(109,111,108); border-width: 2px; border-radius: 7px; padding: 8px; min-width: 0; }
.foundation-field .unity-base-popup-field__text { color: rgb(231,224,210); }
.native-hand > .card { width: 48%; min-height: 114px; padding: 7px; }
.native-hand .cost { font-size: 13px; }
.native-hand .card-name { font-size: 14px; }
.native-hand .card-description { font-size: 13px; }
.native-run > .heading { font-size: 20px; margin-top: 0; margin-bottom: 5px; }
.native-run > .caption { margin-top: 4px; margin-bottom: 5px; }
.native-run > .node-title { font-size: 16px; }
.native-stage { height: 110px; margin-bottom: 5px; }
.native-stage > .fighter { height: 105px; }
.native-target { font-size: 12px; padding: 6px; margin: 3px 0; }
.native-page-count { font-size: 12px; align-self: center; padding: 5px; }
/* Shared original map: shell height is bounded; only the map pans vertically. */
.body.map-screen { padding: 6px 10px 8px; max-width: 1000px; }
.map-screen > .heading { margin: 2px 0 4px; font-size: 18px; }
.map-screen .caption { margin: 3px 0; }
.map-screen .node-title { margin: 3px 0; font-size: 16px; }
.map-screen > .button { margin: 2px 0; padding: 6px; flex-shrink: 0; }
.map-screen #native-run-appearance { display: none; }
.map-board { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.map-tools { flex-direction: row; flex-shrink: 0; align-items: center; }
.map-tool { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 2px; padding: 3px; font-size: 13px; }
.map-viewport { position: relative; flex-grow: 1; flex-shrink: 1; min-height: 0; overflow: hidden; background-color: rgb(21, 24, 26); border-width: 1px; border-color: rgb(66, 60, 49); border-radius: 10px; margin-top: 4px; }
.map-content { position: absolute; left: 0; flex-shrink: 0; }
.map-lines { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.map-node { position: absolute; min-width: 0; min-height: 0; margin: 0; padding: 10px; border-radius: 100px; border-width: 1px; border-color: rgb(105, 92, 70); background-color: rgb(29, 31, 31); }
.map-node:disabled { opacity: 0.85; }
.map-node.available { border-width: 3px; border-color: rgb(240, 197, 117); background-color: rgb(53, 44, 31); }
.map-node.available:hover, .map-node.available:focus { border-color: rgb(255, 237, 199); background-color: rgb(76, 58, 35); }
.map-node.visited { border-color: rgb(167, 128, 72); background-color: rgb(43, 38, 31); }
.map-node.shrine-lane { border-color: rgb(112, 188, 185); }
.map-node.current { border-width: 3px; border-color: rgb(245, 230, 198); background-color: rgb(230, 215, 179); }
.map-node.revealed { border-width: 3px; border-color: rgb(146, 204, 204); }
.map-icon { flex-grow: 1; width: 100%; height: 100%; }
.map-marker { position: absolute; font-size: 9px; color: rgb(233, 199, 130); -unity-text-align: middle-center; white-space: nowrap; }
.map-hint { flex-shrink: 0; font-size: 10px; color: rgb(199, 169, 118); margin-top: 5px; white-space: normal; }
.map-detail { flex-shrink: 0; font-size: 11px; height: 34px; white-space: normal; color: rgb(188, 183, 169); margin-top: 3px; }
.map-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 8px; background-color: rgb(22, 25, 28); }
.map-overlay > .map-tool { flex-grow: 0; flex-basis: auto; }
.map-key-text { white-space: normal; flex-grow: 1; flex-shrink: 1; margin: 8px; font-size: 14px; color: rgb(218, 210, 193); }

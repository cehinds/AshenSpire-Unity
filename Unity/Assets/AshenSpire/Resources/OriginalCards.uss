/* OriginalCards.uss — pinned original card anatomy (kit.css 648–762).
   Load after Expedition.uss. Every selector is scoped to the new component.
   The rail owns spacing/scrolling. Padding above its cards must admit medallions.
   Names, tags and text may grow: no touch-only information is clipped away. */
.original-card.card.html-card { padding: 0; border-width: 0; border-radius: 0; background-color: rgba(0,0,0,0); min-height: 237px; }
.original-card.card.html-card:hover { background-color: rgba(0,0,0,0); }
.original-card.card.html-card.selected { border-width: 2px; border-color: #85bd75; background-color: rgba(45,82,44,0.2); }
.published-card-face { position: relative; width: 100%; height: 237px; min-height: 0; flex-shrink: 0; overflow: visible; }
.original-card.card.owner-card { padding: 4px; border-width: 1px; border-radius: 4px; border-color: #a68b59; background-color: #201b15; min-height: 237px; }
.original-card.card.owner-card:hover { border-color: #ead197; background-color: #29231b; }
.original-card.card.owner-card.selected { border-width: 2px; border-color: #f0d184; background-color: #332b22; }
.owner-card-face { position: relative; width: 100%; height: 229px; min-height: 229px; border-width: 1px; border-color: #b19a66; flex-shrink: 0; padding: 3px; }
.owner-card-name { height: 32px; font-size: 20px; -unity-font: resource("Fonts/OwnerCormorant"); -unity-text-align: middle-center; color: #eee0c1; white-space: normal; margin: 0; padding: 0 6px; }
.owner-card-art { width: 100%; height: 82px; flex-shrink: 0; margin: 0; }
.owner-card-kind { height: 23px; font-size: 11px; -unity-font: resource("Fonts/Cinzel-Regular"); -unity-text-align: middle-center; color: #cbb585; background-color: #34291e; margin: 0; }
.owner-card-kind.attack { color: #cb8567; background-color: #39231c; }
.owner-card-kind.guard { color: #a0bfca; background-color: #273332; }
.owner-card-rules { flex-grow: 1; flex-shrink: 1; min-height: 0; font-size: 19px; -unity-font: resource("Fonts/OwnerCormorant"); color: #eee0c1; white-space: normal; -unity-text-align: middle-center; margin: 0; padding: 5px; }
.owner-card-price { position: absolute; left: -14px; top: -14px; width: 29px; height: 29px; font-size: 20px; -unity-font: resource("Fonts/OwnerCormorant"); color: #efdfb8; background-color: #181611; border-width: 1px; border-color: #c5aa6c; border-radius: 30px; -unity-text-align: middle-center; margin: 0; padding: 0; }
.owner-card-extra-price, .owner-card-stamina-price { position: absolute; right: -5px; top: -10px; height: 24px; font-size: 12px; color: #d4e7f0; background-color: #1d2931; border-width: 1px; border-color: #9bb7c4; border-radius: 8px; padding: 2px 6px; }
.owner-card-stamina-price { top: 18px; color: #eadbb4; background-color: #292b19; }
.original-card.card {
    position: relative; width: 158px; min-width: 158px; min-height: 220px;
    flex-shrink: 0; flex-grow: 0; flex-direction: column; align-items: stretch;
    margin: 12px 8px 8px 12px; padding: 20px 8px 8px;
    border-width: 1px; border-top-width: 3px; border-color: #69634e; border-radius: 8px;
    background-color: #24291f; color: var(--ash-ink);
    white-space: normal; overflow: visible;
}
.original-card.card:hover { border-color: var(--ash-gold); background-color: #303426; }
.original-card.card.rarity-uncommon { border-color: rgb(127,168,201); }
.original-card.card.rarity-rare { border-color: rgb(201,162,39); }
.original-card.card.rarity-special { border-color: rgb(106,58,122); }
.original-card.card.selected { border-color: #f1cf87; background-color: #383b28; }
.original-card.card:focus { border-color: rgb(232,220,192); }
.original-card.card.unaffordable { opacity: 0.7; }
.original-card .original-card-name {
    min-height: 28px; margin: 0 0 6px; padding: 0; font-size: 14px;
    -unity-font-style: bold; -unity-text-align: middle-center;
    color: rgb(232,220,192); white-space: normal;
}
.original-card.upgraded .original-card-name { color: rgb(127,217,127); }
.original-card .original-card-action {
    position: absolute; top: -10px; left: -10px; width: 30px; height: 30px;
    margin: 0; padding: 0; border-width: 2px; border-color: rgb(201,162,39);
    border-radius: 30px; background-color: rgb(13,11,8); color: rgb(232,220,192);
    font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.original-card .original-card-mana, .original-card .original-card-stamina {
    position: absolute; right: -7px; min-width: 32px; height: 24px;
    margin: 0; padding: 0 6px; border-width: 2px; border-radius: 24px;
    font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.original-card .original-card-mana { top: -7px; background-color: rgb(17,27,53); border-color: rgb(79,130,216); color: rgb(207,225,255); }
.original-card .original-card-stamina { top: 19px; background-color: rgb(20,32,22); border-color: rgb(95,146,93); color: rgb(232,220,192); }
.original-card .original-card-art {
    height: 50px; min-height: 50px; flex-shrink: 0; margin: 0 0 6px; padding: 0;
    border-width: 1px; border-color: rgb(58,50,38); border-radius: 3px;
    background-color: #171e17; color: #f2d9a3;
    font-size: 29px; -unity-text-align: middle-center;
}
.original-card .original-card-type {
    min-height: 17px; margin: 0 0 4px; padding: 1px; border-radius: 2px;
    font-size: 11px; letter-spacing: 2px; -unity-text-align: middle-center;
    color: rgb(201,162,39); background-color: rgb(55,47,30);
}
.original-card .original-card-tags { flex-direction: row; flex-wrap: wrap; justify-content: center; margin: 0 0 3px; }
.original-card .original-card-tag {
    margin: 1px; padding: 1px 4px; border-width: 1px; border-radius: 2px;
    font-size: 11px; white-space: normal; color: #d5cbb4;
}
.original-card .original-card-description {
    min-height: 30px; margin: 2px 0 0; padding: 0; font-size: 14px;
    color: #e1d9c4; -unity-text-align: middle-center; white-space: normal;
}
.original-card .original-card-shortage { margin: 4px 0 0; font-size: 11px; color: rgb(224,133,133); white-space: normal; }

.original-card .original-card-name { -unity-font: resource("Fonts/Cinzel-Regular"); }
.original-card .original-card-art { -unity-font: resource("Fonts/NotoSansSymbols2-Regular"); }

/* Card motif (Settings → Display → Card motif / Motif strength; HTML styles/ui.css).
   CampaignView puts card-motif-{off,wash,accent,band} and motif-strength-{subtle,normal,strong}
   on the app root (Domain OriginalDisplayOptions). OriginalCardView adds .original-card-motif,
   tinted inline with the owning class's cardTint, and .original-card-pip. Opacities are
   balance.ui.cardMotifStrength (.06/.10/.17; Accent x 1.3); UnityTests/Mods checks they match. */
.original-card .original-card-motif {
    display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    border-radius: 7px; opacity: 0.1;
}
.original-card .original-card-pip {
    display: none; position: absolute; right: 6px; bottom: 6px; width: 9px; height: 9px;
    border-radius: 9px; background-color: rgb(120,112,92);
}
/* wash: the class tints the card body; rarity keeps the border. */
.card-motif-wash .original-card .original-card-motif { display: flex; }
.card-motif-wash.motif-strength-subtle .original-card .original-card-motif { opacity: 0.06; }
.card-motif-wash.motif-strength-strong .original-card .original-card-motif { opacity: 0.17; }
/* accent: your accent takes the border, rarity moves to a corner pip, the class is a centred sigil. */
.card-motif-accent .original-card.card { border-color: var(--ash-gold); }
.card-motif-accent .original-card.card.selected { border-color: #f1cf87; }
.card-motif-accent .original-card.card:focus { border-color: rgb(232,220,192); }
.card-motif-accent .original-card .original-card-pip { display: flex; }
.card-motif-accent .original-card.rarity-uncommon .original-card-pip { background-color: rgb(127,168,201); }
.card-motif-accent .original-card.rarity-rare .original-card-pip { background-color: var(--ash-gold); }
.card-motif-accent .original-card.rarity-special .original-card-pip { background-color: rgb(106,58,122); }
.card-motif-accent .original-card .original-card-motif {
    display: flex; left: 18%; right: 18%; top: 24%; bottom: 24%; border-radius: 200px; opacity: 0.13;
}
.card-motif-accent.motif-strength-subtle .original-card .original-card-motif { opacity: 0.078; }
.card-motif-accent.motif-strength-strong .original-card .original-card-motif { opacity: 0.221; }
/* band: a class stripe along the top and an accent rule under the art. Strength does not apply. */
.card-motif-band .original-card .original-card-motif {
    display: flex; bottom: auto; height: 5px; border-radius: 0; opacity: 1;
}
.card-motif-band .original-card .original-card-art { border-bottom-width: 2px; border-bottom-color: var(--ash-gold); }
.original-card-grid { flex-direction: row; flex-wrap: wrap; align-items: stretch; }
.original-card-offer { width: 190px; margin: 0 12px 12px 0; }
.original-card-offer > .button { white-space: normal; }
.original-card-inspection { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.original-card.inspection-card { width: 230px; min-width: 230px; padding: 24px 12px 14px; }
.inspection-card .original-card-name { font-size: 19px; }
.inspection-card .original-card-art { height: 82px; font-size: 44px; }
.inspection-card .original-card-description { font-size: 17px; }
.original-card-details { flex-grow: 1; flex-shrink: 1; min-width: 200px; margin: 12px; }
.original-card-browser-tools { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; align-items: flex-start; margin: 8px 0; }
.original-card-browser-tools > * { min-width: 140px; flex-grow: 1; margin: 4px; }
.original-card-grid > .original-card { min-height: 310px; }
.original-card-offer > .original-card { flex-grow: 1; width: auto; min-width: 0; min-height: 260px; }
.original-card-browser-tools > * { min-width: 220px; flex-basis: 28%; flex-direction: column; height: 92px; min-height: 92px; flex-shrink: 0; }
.original-card-browser-tools .unity-base-field__label { min-width: 0; margin: 0 0 5px; color: #e8dcc0; }
.original-card-browser-tools .unity-base-field__input { height: 50px; min-height: 50px; flex-grow: 0; flex-shrink: 0; background-color: #1d261e; color: #f0e7d5; border-width: 1px; border-color: #9c9376; border-radius: 4px; padding: 5px 8px; }
.original-card-browser-tools .unity-text-input { background-color: #1d261e; color: #f0e7d5; }
.original-card-browser-tools .unity-base-popup-field__text { color: #f0e7d5; }
.original-card.card.card-dragging { opacity: 0.55; border-color: #fff0bd; }

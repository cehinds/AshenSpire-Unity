# Generated player-facing artifacts are byte-identity gates. Treating them as
# text lets checkout/autocrlf and test restoration produce different build/dist
# bytes while Git reports a clean tree. Preserve the exact generated bytes.
build/AshenSpire.html -text
dist/AshenSpire.html -text
AshenSpire.html -text

# Exported Unity bytes are verified by hash on Windows and Linux.
Published/** -text
Unity/** text=auto eol=lf
Unity/**/*.png -text
GameContent/** text eol=lf
UnityTests/** text eol=lf
